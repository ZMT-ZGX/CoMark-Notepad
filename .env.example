# Collab Notepad — Environment Variables
# Copy to .env and fill in:  cp .env.example .env
# Keep .env out of git and restrict it:  chmod 600 .env
#
# Every variable below is read by the code. Defaults shown are the values the
# server falls back to when the variable is unset.

# ── Core (required) ────────────────────────────────────────────────

# HMAC signing key for session cookies. REQUIRED when NODE_ENV=production
# (the server refuses to boot without it). Generate: openssl rand -hex 32
# Changing this invalidates every existing session (logs everyone out).
SESSION_SECRET=

# Your public URL, e.g. https://notepad.example.com
# Used for the CSRF origin check and for share links / QR codes.
# Must start with https:// in production: session cookies carry the Secure
# flag, so a plain http origin will make login silently fail.
PUBLIC_ORIGIN=

# ── Runtime ────────────────────────────────────────────────────────

# production | development
# In production: requires SESSION_SECRET, adds Secure to cookies, emits
# JSON logs, and runs the startup config self-check.
NODE_ENV=production

# Port the server listens on inside the container. Default 8000.
PORT=8000

# Directory for store.db, uploaded files and the legacy store.json.
# In Docker this is the mount point of the data volume.
DATA_DIR=/app/data

# ── Network / reverse proxy ────────────────────────────────────────

# Number of proxy hops to trust for X-Forwarded-For. Default 0.
# Set to 1 when running behind Caddy/Nginx/Traefik. If left at 0 while
# behind a proxy, every request appears to come from the proxy, which
# collapses the HTTP rate limiter and the per-IP WebSocket cap into a
# single shared bucket.
TRUST_PROXY_HOPS=1

# ── Security & limits ──────────────────────────────────────────────

# Global admin token for pad management. Optional; unset disables admin
# routes. Treat like a password. Also used to grant/revoke trusted-member
# write access (see WRITE_ACCESS_MODE).
ADMIN_TOKEN=

# ── Write-access gate ──────────────────────────────────────────────
# Who can edit. Two modes:
#   open  (default) — anyone who can reach the instance may edit. Correct for
#                     LAN / single-user. NEVER use on the public internet.
#   gated           — visitors are read-only until they hold a write grant:
#                     a redeemed passphrase (time-limited, sliding renewal)
#                     or admin-granted trusted status (permanent, revocable).
#                     Required for any internet-facing deployment, because
#                     /api/auth/register needs no credentials.
WRITE_ACCESS_MODE=open

# Write passphrases, comma-separated: `<phrase>[:<days>]`.
#   team2026         → default TTL (WRITE_GRANT_TTL_DAYS)
#   contractor:1     → 1-day grant
# Leave empty if you only grant access via the admin members API.
# WRITE_PASSPHRASES=

# Default validity of a passphrase-redeemed grant, in days. Default 7.
WRITE_GRANT_TTL_DAYS=7

# Sliding renewal threshold (days). A grant whose remaining life drops below
# this is pushed back to a full TTL on the next write, so an active writer
# never lapses mid-edit. Default 5.
WRITE_GRANT_RENEW_THRESHOLD_DAYS=5

# Session cookie lifetime in days. Default 30.
SESSION_TOKEN_TTL_DAYS=30

# Max simultaneous WebSocket connections, global. Default 1000.
MAX_WS_CONNECTIONS=1000

# Max simultaneous WebSocket connections per IP. Default 10.
# Guards one client from exhausting the global pool.
MAX_WS_CONNECTIONS_PER_IP=10

# Per-connection WebSocket patch rate limit: max patches per window.
# Default 120 per 60s. HTTP writes are separately limited by
# express-rate-limit (300 / 15min general, 10 / 15min for pad deletes).
WS_PATCH_WINDOW_MS=60000
MAX_WS_PATCHES_PER_WINDOW=120

# Admit WebSocket clients that send no Origin header. Default false —
# the server fails closed: browsers always send Origin on the handshake,
# so a missing Origin identifies a scripted (non-browser) client. Set to
# true only if you drive the editor from CLI tools / scripts.
# WS_ALLOW_NO_ORIGIN=false

# ── Storage & files ────────────────────────────────────────────────

# Instance-wide aggregate storage cap. A rejected upload leaves nothing
# on disk (checked before the temp file is promoted). Default 2GB.
# MAX_STORAGE_BYTES=2147483648

# Per-account aggregate storage cap. Default 512MB.
# MAX_STORAGE_BYTES_PER_USER=536870912

# Auto-delete uploaded files older than N hours — but only when no pad body
# links to them (an attachment referenced by `/api/files/<id>` survives the
# TTL, otherwise the pad would show a broken image/link). Default 72.
FILE_TTL_HOURS=72

# ── Search index ───────────────────────────────────────────────────

# The FTS (trigram) index refresh is throttled per pad: a keystroke burst
# reindexes a body once per window instead of once per character. The pad
# row itself is still written synchronously on every edit, so crash-window
# data loss is unchanged; only search can lag by up to this window (the
# index is rebuilt from the pads table on every boot). Default 1200 ms.
FTS_SYNC_DEBOUNCE_MS=1200

# ── Logging & observability ────────────────────────────────────────

# fatal | error | warn | info | debug | trace | silent. Default info.
# Use debug when diagnosing sync or auth issues, then set back to info.
LOG_LEVEL=info

# ── Markdown conversion (advanced) ─────────────────────────────────

# Max file size accepted for Markdown conversion. Default 104857600 (100MB).
# Each conversion runs in a worker thread with its own heap, so raising this
# raises peak memory. Keep it below the container memory limit. Also used as
# the archive-decompression cap in the OOXML bomb guard.
# CONVERT_MAX_BYTES=104857600

# Conversion timeout in ms. Default 60000.
# CONVERT_TIMEOUT_MS=60000
